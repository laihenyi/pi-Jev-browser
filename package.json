{
  "name": "pi-jev-browser",
  "version": "0.3.0",
  "description": "Browser and macOS desktop agent for pi: Jev (TypeSafe System One) chooses each action from a structured observation in a bounded, surface-agnostic loop. Isolated Playwright tools, an allow-listed accessibility-tree tool, a deterministic selector layer and a four-tier benchmark suite.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laihenyi/pi-Jev-browser.git"
  },
  "homepage": "https://github.com/laihenyi/pi-Jev-browser#readme",
  "bugs": {
    "url": "https://github.com/laihenyi/pi-Jev-browser/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "browser-automation",
    "playwright",
    "agent",
    "jev",
    "typesafe",
    "accessibility-tree",
    "macos",
    "benchmark"
  ],
  "files": [
    "index.ts",
    "src/",
    "desktop/ax-helper.swift",
    "benchmarks/desktop-calibration.ts",
    "benchmarks/README.md",
    "benchmarks/run.ts",
    "benchmarks/lib/",
    "benchmarks/scenarios/",
    "test/",
    "pi-jev-browser.config.example.json",
    "docs/",
    "README.md",
    "README.zh-TW.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "benchmark": "node benchmarks/run.ts",
    "install-browser": "playwright install chromium",
    "build:ax-helper": "swiftc -O -o desktop/ax-helper desktop/ax-helper.swift"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "playwright": "^1.58.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
